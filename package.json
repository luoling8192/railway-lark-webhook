{
  "name": "railway-lark-webhook",
  "version": "1.0.0",
  "description": "Convert Railway deployment and resource alert webhooks into Lark or Feishu message cards.",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run typecheck && npm run deploy:dry",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luoling8192/railway-lark-webhook.git"
  },
  "keywords": [
    "railway",
    "lark",
    "feishu",
    "webhook",
    "alerts"
  ],
  "license": "MIT",
  "overrides": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  }
}
